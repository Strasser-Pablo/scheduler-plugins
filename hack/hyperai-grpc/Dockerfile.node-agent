FROM python:3.11-slim

WORKDIR /app

# Install required Python packages
RUN pip install grpcio grpcio-tools kubernetes

# Copy gRPC generated code
COPY hyperai_pb2.py .
COPY hyperai_pb2_grpc.py .

# Copy node agent application
COPY node_agent.py .

# Make sure the script is executable
RUN chmod +x node_agent.py

# Expose gRPC port
EXPOSE 50051

# Run the node agent
CMD ["python3", "node_agent.py"]