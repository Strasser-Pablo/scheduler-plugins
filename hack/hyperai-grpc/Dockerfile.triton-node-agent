# Dockerfile for Triton-enabled HyperAI Node Agent
FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy Python requirements and install dependencies
COPY requirements-triton.txt ./
RUN pip install --no-cache-dir -r requirements-triton.txt

# Copy the enhanced node agent and protobuf files
COPY triton_node_agent.py .
COPY triton_models/ ./triton_models/
COPY hyperai_pb2.py .
COPY hyperai_pb2_grpc.py .
COPY hyperai.proto .

# Create non-root user
RUN useradd -r -u 1000 nodeagent
USER nodeagent

# Expose gRPC port
EXPOSE 50051

# Run the node agent
CMD ["python", "triton_node_agent.py"]